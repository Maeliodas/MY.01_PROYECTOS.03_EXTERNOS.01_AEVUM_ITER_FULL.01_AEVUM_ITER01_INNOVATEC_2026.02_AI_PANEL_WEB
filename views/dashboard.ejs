<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="color-scheme" content="light">
  <title>Aevum Iter · Administración</title>
  <link rel="stylesheet" href="/styles.css">
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#0262FC">
  <link rel="apple-touch-icon" href="/icons/icon-192.png">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
  <div class="layout">
    <aside class="sidebar">
      <div class="brand"><span class="brand-mark"><img src="/img/app-logo.png" alt="Aevum Iter"></span><div><strong>AEVUM ITER</strong><small>Administración</small></div></div>
      <nav>
        <button class="nav-btn active" data-view="dashboard">Resultados</button>
        <button class="nav-btn" data-view="catalogs">Catálogos</button>
      </nav>
      <div class="sidebar-foot"><form method="post" action="/logout"><button class="logout-btn" type="submit">Cerrar sesión</button></form><small>Panel v<%= panelVersion %></small><small>Versión de catálogos</small><strong id="catalogVersion">#<%= catalogs.meta?.version ?? 1 %></strong><span>Los cambios aprobados se sincronizan con la app.</span></div>
    </aside>

    <main class="main">
      <header class="topbar">
        <div><p class="eyebrow">AEVUM ITER</p><h1>Panel de orientación vocacional</h1></div>
        <div class="status" id="liveStatus"><i></i><span>Servidor conectado</span></div>
      </header>

      <section id="view-dashboard" class="view active">
        <form class="filters card" id="filterForm" method="get" action="/">
          <div class="filter-head"><div><p class="eyebrow">FILTROS</p><h2>Explorar resultados</h2></div>
            <div style="display:flex;gap:10px;align-items:center">
              <a class="clear-link" href="/" id="clearFilters">Limpiar filtros</a>
              <a class="primary" id="downloadPdf" href="/api/admin/report.pdf" style="text-decoration:none;padding:8px 14px;border-radius:8px;font-size:12px;font-weight:700">Descargar PDF</a>
            </div>
          </div>
          <div class="filter-grid">
            <label>Perfil
              <select name="profile"><option value="">Todos</option><% for (const code of data.profileCodes ?? []) { %><option value="<%= code %>" <%= filters.profile===code?'selected':'' %>><%= code %></option><% } %></select>
            </label>
            <label>Carrera
              <select name="career"><option value="">Todas</option><% for (const row of catalogs.careers ?? []) { if(row.active) { %><option value="<%= row.id %>" <%= filters.career===row.id?'selected':'' %>><%= row.name %></option><% } } %></select>
            </label>
            <label>Desde<input type="date" name="from" value="<%= filters.from ?? '' %>"></label>
            <label>Hasta<input type="date" name="to" value="<%= filters.to ?? '' %>"></label>
            <button class="primary" type="submit">Aplicar filtros</button>
          </div>
        </form>

        <section class="kpis" id="kpiSection">
          <article><span>Evaluaciones</span><strong id="kpiEvaluations"><%= data.totals.total_evaluations ?? 0 %></strong><small>según filtros actuales</small></article>
          <article><span>Perfiles</span><strong id="kpiProfiles"><%= data.totals.profiles ?? 0 %></strong><small>códigos Holland</small></article>
          <article><span>Afinidad media</span><strong id="kpiAffinity"><%= data.totals.average_affinity ?? '—' %><%= data.totals.average_affinity != null ? '%' : '' %></strong><small>carrera principal</small></article>
        </section>

        <section class="dashboard-grid">
          <article class="card span-2"><div class="card-head"><div><h3>Carreras recomendadas</h3><p>Distribución de recomendaciones principales</p></div></div><div class="chart chart-wide"><canvas id="careerChart"></canvas></div></article>
          <article class="card"><div class="card-head"><div><h3>Perfiles Holland</h3><p>Frecuencia por código</p></div></div><div class="chart"><canvas id="profileChart"></canvas></div></article>
          <article class="card"><div class="card-head"><div><h3>Rangos de afinidad</h3><p>Concentración porcentual</p></div></div><div class="chart"><canvas id="affinityChart"></canvas></div></article>
        </section>

        <section class="records card">
          <div class="records-head"><div><p class="eyebrow">EVALUACIONES</p><h2>Registros</h2><p>Perfil, carrera, afinidad y fecha.</p></div><label class="search">Buscar<input id="tableSearch" type="search" placeholder="Carrera, perfil…"></label></div>
          <div class="table-wrap"><table><thead><tr><th>Perfil</th><th>Carrera recomendada</th><th>Afinidad</th><th>Fecha</th></tr></thead><tbody id="evaluationRows">
          <% for (const row of data.evaluations ?? []) { %><tr><td><span class="code"><%= row.holland_code %></span></td><td><%= row.top_career_name %></td><td><span class="affinity"><%= Number(row.top_career_affinity ?? 0).toFixed(1) %>%</span></td><td><%= new Date(row.completed_at).toLocaleDateString('es-MX',{day:'2-digit',month:'short',year:'numeric'}) %></td></tr><% } %>
          <% if (!(data.evaluations ?? []).length) { %><tr><td colspan="4" class="empty">No hay evaluaciones para los filtros seleccionados.</td></tr><% } %>
          </tbody></table></div>
        </section>
      </section>

      <section id="view-catalogs" class="view">
        <div class="section-title"><div><p class="eyebrow">BASE DE DATOS</p><h2>Administración de catálogos</h2><p>Altas, cambios y bajas lógicas. La app recibe estos cambios al sincronizar.</p></div></div>
        <div class="catalog-tabs">
          <button class="catalog-tab active" data-catalog="careers">Carreras</button><button class="catalog-tab" data-catalog="questions">Preguntas</button>
        </div>

        <div class="catalog-panel active" id="catalog-careers"><%- include('partials/catalog_careers', {catalogs}) %></div>
        <div class="catalog-panel" id="catalog-questions"><%- include('partials/catalog_questions', {catalogs}) %></div>
      </section>

      <footer><strong>Aevum Iter · Panel v<%= panelVersion %></strong><span>Administración de resultados y catálogos</span></footer>
    </main>
  </div>

  
  <div class="aevum-modal-backdrop" id="aevumModal" aria-hidden="true">
    <div class="aevum-modal" role="dialog" aria-modal="true" aria-labelledby="aevumModalTitle">
      <div class="aevum-modal-head">
        <p class="eyebrow">CONFIRMACIÓN</p>
        <h3 id="aevumModalTitle">¿Continuar?</h3>
      </div>
      <div class="aevum-modal-body">
        <p id="aevumModalMessage"></p>
        <p class="muted" id="aevumModalHint"></p>
      </div>
      <div class="aevum-modal-actions">
        <button type="button" class="btn-cancel" id="aevumModalCancel">Cancelar</button>
        <button type="button" class="btn-confirm" id="aevumModalConfirm">Aceptar</button>
      </div>
    </div>
  </div>

  <script id="dashboard-data" type="application/json"><%- JSON.stringify({careers:data.careers,schools:data.schools,provenance:data.provenance,profiles:data.profiles,affinity:data.affinity,languages:data.languages,idioms:data.idioms,municipalities:catalogs.municipalities,schoolCatalog:catalogs.schools}) %></script>
  <script src="/socket.io/socket.io.js"></script>
  <script src="/admin.js?v=<%= panelVersion %>"></script>
  <script>if('serviceWorker' in navigator){navigator.serviceWorker.register('/sw.js').catch(function(){})}</script>
</body>
</html>